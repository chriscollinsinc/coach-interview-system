# Postgres connection string. Render provides this automatically.
DATABASE_URL=postgres://user:pass@localhost:5432/cci_interviews

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Anthropic API key for the narrative analysis pass. The app runs fine without it;
# the deterministic dashboard still works, the LLM narrative button is just disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=3000
NODE_ENV=development

# Bootstrap admin, created by `npm run seed` if no users exist yet.
BOOTSTRAP_ADMIN_EMAIL=mike@chriscollinsinc.com
BOOTSTRAP_ADMIN_NAME=Mike
BOOTSTRAP_ADMIN_PASSWORD=
