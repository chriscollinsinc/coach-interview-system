      "analysis": { "dimension": "department_cohesion", "verbatim": true } },

    { "key": "parts_requisition_used",
      "prompt": "Do technicians use parts requisition forms?",
      "type": "single_select",
      "options": [
        { "value": "yes",       "label": "Yes" },
        { "value": "no",        "label": "No" },
        { "value": "sometimes", "label": "Sometimes" }
      ],
      "analysis": { "dimension": "parts_process_discipline", "compare_across_roles": true } },

    { "key": "parts_prepulled",
      "prompt": "Are parts pre-pulled or pre-packaged for scheduled work?",
      "type": "single_select",
      "options": [
        { "value": "yes",       "label": "Yes" },
        { "value": "no",        "label": "No" },
        { "value": "sometimes", "label": "Sometimes" }
      ],
      "analysis": { "dimension": "parts_process_discipline", "compare_across_roles": true } },

    {
      "key": "parts_delivered_to_stall",
      "prompt": "Are parts delivered to the technician's stall?",
      "type": "single_select",
      "options": [
        { "value": "yes",       "label": "Yes" },
        { "value": "no",        "label": "No" },
        { "value": "sometimes", "label": "Sometimes" }
      ],
      "analysis": { "dimension": "parts_delivery", "compare_across_roles": true,
                    "headline": true,
                    "note": "Asked of both Parts and Technicians. A Parts 'yes' against a Technician 'no' is the finding." }
    },

    {
      "key": "parts_delay_cause",
      "prompt": "What causes the most common delays in getting parts to technicians?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "availability",  "label": "Availability" },
        { "value": "incorrect",     "label": "Incorrect parts" },
        { "value": "wait_time",     "label": "Wait time" },
        { "value": "communication", "label": "Communication" },
        { "value": "none",          "label": "None" }
      ],
      "analysis": { "dimension": "parts_delay_cause", "compare_across_roles": true,
                    "headline": true,
                    "note": "Mirror question. Parts and Technicians frequently name different causes." }
    },

    { "key": "techs_could_improve",
      "prompt": "Anything the techs could do to make your life easier?",
