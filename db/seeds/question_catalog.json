{
  "_readme": [
    "Canonical question catalog. One entry per question CONCEPT, shared across every survey.",
    "analysis.dimension is the comparison axis: any question carrying the same dimension pools",
    "into the same cross-role chart regardless of which survey it came from. Add a Service",
    "Manager survey later that includes rel_parts_service and the SM's rating drops into the",
    "existing gap chart with zero code changes.",
    "polarity 'higher_is_better' tells the dashboard which direction is good.",
    "verbatim:true marks free text worth quoting in the narrative analysis."
  ],

  "questions": [
    {
      "key": "tenure_company",
      "prompt": "Time with company",
      "type": "short_text",
      "help_text": "e.g. 3 years, 8 months",
      "analysis": { "dimension": "tenure", "compare_across_roles": true }
    },

    {
      "key": "has_job_description",
      "prompt": "Do you have a written job description?",
      "type": "yes_no",
      "analysis": { "dimension": "job_description_exists", "compare_across_roles": true,
                    "polarity": "yes_is_better" }
    },

    {
      "key": "pay_structure",
      "prompt": "How are you paid?",
      "type": "single_select",
      "allow_other": true,
      "options": [
        { "value": "flat_rate",  "label": "Flat Rate" },
        { "value": "hourly",     "label": "Hourly" },
        { "value": "salary",     "label": "Salary" },
        { "value": "commission", "label": "Commission" }
      ],
      "analysis": { "dimension": "pay_structure", "compare_across_roles": true }
    },

    { "key": "primary_role_support",
      "prompt": "What is your primary role / area of responsibility?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "porter",    "label": "Porter" },
        { "value": "warranty",  "label": "Warranty / Admin" },
        { "value": "bdc",       "label": "BDC" },
        { "value": "cashier",   "label": "Cashier" }
      ]
    },

    { "key": "primary_role_parts",
      "prompt": "What is your primary role / area of responsibility?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "counter",   "label": "Counter" },
        { "value": "driver",    "label": "Driver" },
        { "value": "warehouse", "label": "Warehouse / Stock" },
        { "value": "wholesale", "label": "Wholesale" }
      ]
    },

    { "key": "background_experience",
      "prompt": "Tell me about your background and experience.",
      "type": "long_text",
      "analysis": { "verbatim": true } },

    { "key": "career_origin",
      "prompt": "What got you into teching?",
      "type": "long_text",
      "analysis": { "verbatim": true } },

    { "key": "career_outlook_1yr",
      "prompt": "Where do you see yourself in a year?",
      "type": "long_text",
      "analysis": { "dimension": "retention_signal", "verbatim": true } },

    { "key": "typical_day",
      "prompt": "Walk me through your typical day.",
      "type": "long_text",
      "analysis": { "verbatim": true } },

    { "key": "preferred_work_type",
      "prompt": "What type of work do you like to do most?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "maintenance", "label": "Maintenance" },
        { "value": "mechanical",  "label": "Mechanical" },
        { "value": "electrical",  "label": "Electrical / Diagnostic" }
      ] },

    { "key": "work_interruptions",
      "prompt": "Is there anything that slows down or interrupts your work?",
      "type": "long_text",
      "analysis": { "dimension": "productivity_blocker", "verbatim": true } },

    { "key": "self_productivity",
      "prompt": "How would you rate your overall ability to stay productive?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "self_productivity", "polarity": "higher_is_better" } },

    { "key": "biggest_slowdown",
      "prompt": "What is the biggest thing that slows you down?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "parts",      "label": "Parts" },
        { "value": "dispatch",   "label": "Dispatch" },
        { "value": "approvals",  "label": "Approvals" },
        { "value": "advisor",    "label": "Advisor" },
        { "value": "tools",      "label": "Tools / Equipment" },
        { "value": "workload",   "label": "Workload" }
      ],
      "analysis": { "dimension": "productivity_blocker", "compare_across_roles": true } },

    { "key": "avg_flagged_hours",
      "prompt": "Average flagged hours per week",
      "type": "number",
      "help_text": "Hours",
      "analysis": { "dimension": "flagged_hours" } },

    { "key": "flag_hours_blockers",
      "prompt": "What most affects your ability to flag hours?",
      "type": "multi_select",
      "options": [
        { "value": "lack_of_work",   "label": "Lack of work" },
        { "value": "parts_delays",   "label": "Parts delays" },
        { "value": "dispatch",       "label": "Dispatch" },
        { "value": "approvals",      "label": "Approvals" },
        { "value": "diag_time",      "label": "Diagnostic time" },
        { "value": "tools",          "label": "Tools / Equipment" },
        { "value": "advisor_comm",   "label": "Advisor communication" },
        { "value": "rework",         "label": "Rework / Comebacks" },
        { "value": "all_of_above",   "label": "All of the above" }
      ],
      "analysis": { "dimension": "productivity_blocker", "compare_across_roles": true } },

    { "key": "work_assignment_method",
      "prompt": "How is work typically assigned to you?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "advisor",     "label": "Advisor" },
        { "value": "dispatcher",  "label": "Dispatcher" },
        { "value": "tech_pulls",  "label": "Technician pulls work" }
      ] },

    { "key": "help_escalation",
      "prompt": "Who do you go to when you need help?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "lead_tech", "label": "Lead / Senior Tech" },
        { "value": "advisor",   "label": "Advisor" },
        { "value": "manager",   "label": "Manager" }
      ] },

    { "key": "job_easier_lever",
      "prompt": "What is one thing that would make your job easier?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "parts",         "label": "Parts" },
        { "value": "tools",         "label": "Tools" },
        { "value": "training",      "label": "Training" },
        { "value": "communication", "label": "Communication" },
        { "value": "workflow",      "label": "Workflow" }
      ],
      "analysis": { "dimension": "improvement_lever" } },

    { "key": "dispatch_rating",
      "prompt": "How would you rate the dispatch process?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "dispatch_quality", "polarity": "higher_is_better",
                    "compare_across_roles": true } },

    { "key": "dispatch_improvement",
      "prompt": "What would improve the dispatch process?",
      "type": "long_text",
      "help_text": "Asked when dispatch is rated below Excellent.",
      "analysis": { "dimension": "dispatch_quality", "verbatim": true } },

    { "key": "checkin_authority",
      "prompt": "Do you have to check in with anyone when you come in?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "advisor",       "label": "Advisor" },
        { "value": "manager",       "label": "Manager" },
        { "value": "dispatcher",    "label": "Dispatcher" },
        { "value": "self_directed", "label": "Self-Directed" }
      ] },

    { "key": "primary_interaction",
      "prompt": "Who do you interact with most in your role?",
      "type": "multi_select", "allow_other": true,
      "options": [
        { "value": "advisors",   "label": "Service Advisors" },
        { "value": "technicians","label": "Technicians" },
        { "value": "parts",      "label": "Parts" },
        { "value": "management", "label": "Management" },
        { "value": "customers",  "label": "Customers" }
      ] },

    {
      "key": "rel_parts_service",
      "prompt": "How would you rate the working relationship between Parts and Service?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "parts_service_relationship",
                    "compare_across_roles": true, "polarity": "higher_is_better",
                    "headline": true }
    },

    { "key": "rel_with_advisors",
      "prompt": "How would you rate your relationship with Service Advisors?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "advisor_relationship", "compare_across_roles": true,
                    "polarity": "higher_is_better" } },

    { "key": "comm_with_advisors",
      "prompt": "How would you rate communication with Service Advisors?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "advisor_communication", "compare_across_roles": true,
                    "polarity": "higher_is_better", "headline": true } },

    { "key": "comm_with_techs",
      "prompt": "How would you rate communication with Technicians?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "tech_communication", "compare_across_roles": true,
                    "polarity": "higher_is_better" } },

    { "key": "rel_advisors_techs",
      "prompt": "How would you rate the working relationship between Advisors and Technicians?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "advisor_tech_relationship", "compare_across_roles": true,
                    "polarity": "higher_is_better", "headline": true } },

    { "key": "rel_service_sales",
      "prompt": "How would you rate the working relationship between Service and Sales?",
      "type": "rating",
      "scale": { "min": 1, "max": 3,
                 "labels": { "1": "Poor", "2": "Average", "3": "Excellent" } },
      "analysis": { "dimension": "service_sales_relationship", "compare_across_roles": true,
                    "polarity": "higher_is_better" } },

    { "key": "dept_cohesion",
      "prompt": "How well does the Service Department work together? Well-oiled machine, or needs some help?",
      "type": "long_text",
      "analysis": { "dimension": "department_cohesion", "verbatim": true } },

    { "key": "biggest_comm_gap",
      "prompt": "Where do you see the biggest communication gap?",
      "type": "single_select", "allow_other": true,
      "options": [
        { "value": "advisors",    "label": "Advisors" },
        { "value": "technicians", "label": "Technicians" },
        { "value": "parts",       "label": "Parts" },
        { "value": "management",  "label": "Management" }
      ],
      "analysis": { "dimension": "communication_gap", "compare_across_roles": true } },

    { "key": "improve_teamwork",
      "prompt": "What would improve teamwork between departments?",
